vendor/
tools/node_modules/
tools/.venv-img/
.venv/
.chrome-render/
.chrome-tmp-*/
.serve.log
.serve.pid
__pycache__/
.build/
.swiftpm/
# copied in by CI (single source of truth lives in ios/GlassCoinAvatar)
ios/Standalone/Core/Sources/GlassCoinCore/*.swift
ios/Standalone/TypeCheck/Sources/GlassCoinAvatar/*.swift
ios/Standalone/LivingIconsCore/Sources/LivingIconsCore/*.swift
ios/Standalone/LivingIconsTypeCheck/Sources/LivingSettingsIcons/*.swift
ios/Standalone/DepthSwipeCore/Sources/DepthSwipeCore/*.swift
ios/Standalone/DepthSwipeTypeCheck/Sources/DepthSwipe/*.swift
