+            // rest): the glass dissolves over the end of the motion instead of after it.
+            let error = Double(self.targetHalfTurn) * Double.pi - yaw
+            let velocity = self.yaw.velocity
+            let atRest = abs(error) < 0.035 && abs(velocity) < 0.6
