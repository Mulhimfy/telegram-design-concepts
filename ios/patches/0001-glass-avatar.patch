+    }
+
+    public var isAnimating: Bool {
+        return self.spin != nil || self.mode != .idle || !self.lift.isSettled || !self.glass.isSettled || !self.pitch.isSettled || !self.yaw.isSettled || !self.offsetX.isSettled || !self.offsetY.isSettled
+    }
+}
