@@ -0,0 +1,81 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import TelegramPresentationData
+
+/// The own glass avatar's options (GlassCoinAvatar), kept on this device until the profile has fields for them.
+/// TODO(server): a `glass_color` user profile field (synced, and shown to others), replacing this store.
+enum PeerInfoGlassAvatarStore {
+    /// The glass colours to choose from (prototype/src/ui/glass-sheets.js GLASS_COLORS); nil is clear glass.
+    /// TODO(localization): the colour names.
+    static let colors: [(title: String, rgb: UInt32?)] = [
+        ("Clear", nil),
+        ("Gold", 0xf5b03c),
+        ("Rose", 0xf0549c),
+        ("Violet", 0x7d62f4),
+        ("Blue", 0x3e8bff),
+        ("Aqua", 0x2fd3c4),
+        ("Green", 0x48d16a),
+        ("Ember", 0xff6a3d)
+    ]
+
+    private static func colorKey(context: AccountContext) -> String {
+        return "glassAvatar.color.\(context.account.peerId.id._internalGetInt64Value())"
+    }
+
+    static func glassColorRGB(context: AccountContext) -> UInt32? {
+        guard let value = UserDefaults.standard.object(forKey: colorKey(context: context)) as? NSNumber else {
+            return nil
+        }
+        return value.uint32Value
+    }
+
+    static func glassColor(context: AccountContext) -> UIColor? {
+        return glassColorRGB(context: context).flatMap { UIColor(rgb: $0) }
+    }
+
+    static func setGlassColor(_ rgb: UInt32?, context: AccountContext) {
+        if let rgb {
+            UserDefaults.standard.set(NSNumber(value: rgb), forKey: colorKey(context: context))
+        } else {
+            UserDefaults.standard.removeObject(forKey: colorKey(context: context))
+        }
+    }
+}
+
+extension PeerInfoScreenImpl {
+    /// "Change Glass Color": the colours in an action sheet; the pick is stored and the glass takes it, sending its
+    /// light over the screen once the sheet is gone.
+    func openGlassColorSetup() {
+        let presentationData = self.presentationData
+        let current = PeerInfoGlassAvatarStore.glassColorRGB(context: self.context)
+        let actionSheet = ActionSheetController(presentationData: presentationData)
+        var items: [ActionSheetItem] = []
+        // TODO(localization): GlassAvatar.ColorInfo and the colour names.
+        items.append(ActionSheetTextItem(title: "Glows when your photo turns to glass."))
+        for option in PeerInfoGlassAvatarStore.colors {
+            items.append(ActionSheetCheckboxItem(title: option.title, label: "", value: option.rgb == current, action: { [weak self, weak actionSheet] _ in
+                actionSheet?.dismissAnimated()
+                guard let self, option.rgb != current else {
+                    return
+                }
+                PeerInfoGlassAvatarStore.setGlassColor(option.rgb, context: self.context)
+                Queue.mainQueue().after(0.3) { [weak self] in
+                    self?.controllerNode.headerNode.setGlassColor(option.rgb.flatMap { UIColor(rgb: $0) }, animated: true)
+                }
+            }))
+        }
+        actionSheet.setItemGroups([
+            ActionSheetItemGroup(items: items),
+            ActionSheetItemGroup(items: [
+                ActionSheetButtonItem(title: presentationData.strings.Common_Cancel, color: .accent, font: .bold, action: { [weak actionSheet] in
+                    actionSheet?.dismissAnimated()
+                })
+            ])
+        ])
+        self.present(actionSheet, in: .window(.root))
+    }
+}
