+
+    /// Programmatic flick (VoiceOver adjustable action, demos): `velocity` in pt/s.
+    public func flick(velocity: Double, at time: Double) {
+        self.update(at: time)
+        self.startHalfTurn = glassCoinRound(self.yaw.value / Double.pi)
