+    }
+
+    /// Frees every face except `keep`.
+    public func retainFaceImages(_ keep: Set<GlassCoinFaceContent>) {
+        self.faceTextures = self.faceTextures.filter { keep.contains($0.key) }
+    }
+
+    public func removeAllFaceImages() {
