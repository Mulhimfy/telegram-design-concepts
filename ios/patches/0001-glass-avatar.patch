+    }
+
+    /// Shows `face` at rest without animation (Reduce Motion, state restoration).
+    public func jump(toFace face: Int, at time: Double) {
+        self.update(at: time)
+        self.spin = nil
+        let angle = -Double(face) * Double.pi
