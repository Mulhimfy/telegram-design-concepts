+import Foundation
+
+// The effects of prototype/src/settings/living-icons.js — the `fx` object built in `play()` and the
+// tile's pop, sheen and press in `update()` / `press()` — as pure functions of time. Each returns what
+// the prototype writes into the DOM that frame; the layer view (LivingSettingsIconLayer) applies it to
+// its layers. Pure Swift (parity-tested against the web).
+
+public enum LivingIconFX {
+    private typealias C = LivingIconCurves
+    private static let degree = Double.pi / 180.0
+
+    // MARK: - The tile (update(), press())
+
+    /// The tile's spring pop: up 16 % in 0.09 s, back on a spring (`update()`).
+    public static func tileScale(_ t: Double) -> Double {
+        return t < 0.09 ? 1.0 + 0.16 * C.easeOut(t / 0.09) : 1.0 + 0.16 * (1.0 - C.pop(t, 0.34, 0.09, 0.42))
+    }
+
+    /// The sheen crossing the tile: `translateX(-100% … 100%)` of its own width, 0.06 → 0.56 s (`update()`).
+    public static func sheenOffset(_ t: Double) -> Double {
+        let u = C.clamp((t - 0.06) / 0.5)
+        return -100.0 + 200.0 * C.ease(u)
+    }
+
+    /// The tap that opens the row's page: the tile gives under the finger (squash, spring back);
+    /// nil once it is over (0.6 s), when the tile is itself again (`press()` / `update()`).
+    public static func pressScale(_ t: Double) -> Double? {
+        if t > 0.6 {
+            return nil
+        }
+        return t < 0.07 ? 1.0 - 0.12 * C.easeOut(t / 0.07) : 0.88 + 0.12 * C.pop(t, 0.3, 0.07, 0.55)
+    }
+
+    // MARK: - fx
+
+    /// One sound-wave arc: `side` −1 (left) / 1 (right), drawn `translate(dx, 0)` at `opacity`.
+    public struct Arc: Equatable {
+        public var side: Double
+        public var opacity: Double
+        public var dx: Double
+    }
+
+    /// `fx.waves(t, t0, n)`: n arcs on each side, expanding and fading, each 0.18 of its run after the one before.
+    public static func waves(_ t: Double, _ t0: Double, _ n: Int) -> [Arc] {
+        let u = (t - t0) / 0.6
+        var arcs: [Arc] = []
+        for i in 0 ..< n * 2 {
+            let side: Double = i % 2 != 0 ? 1.0 : -1.0
+            let k = Double(i / 2)
+            let v = C.clamp(u - k * 0.18)
+            arcs.append(Arc(side: side, opacity: v > 0.0 && v < 1.0 ? sin(Double.pi * v) : 0.0, dx: side * 3.5 * v))
+        }
+        return arcs
+    }
+
+    /// `fx.glow(t, t0, k)`: a white `drop-shadow(0 0 radius)` of `alpha` around the glyph, nil while off.
+    public static func glow(_ t: Double, _ t0: Double, _ k: Double) -> (radius: Double, alpha: Double)? {
+        let v = t < t0 ? 0.0 : sin(Double.pi * C.clamp((t - t0) / 0.5))
+        return v > 0.01 ? (4.0 * v, k * v) : nil
+    }
+
+    /// `fx.glint(t, t0)`: the tile's sheen sent across again at `t0` (replaces `sheenOffset` that frame).
+    public static func glint(_ t: Double, _ t0: Double) -> Double {
+        let u = C.clamp((t - t0) / 0.45)
+        return -100.0 + 200.0 * C.ease(u)
+    }
+
+    /// `fx.halo(t, t0)`: a 2 pt ring of the tile's colour around the tile, growing and fading.
+    public static func halo(_ t: Double, _ t0: Double) -> (opacity: Double, scale: Double) {
+        let u = C.clamp((t - t0) / 0.55)
+        return (u > 0.0 && u < 1.0 ? (1.0 - u) * 0.8 : 0.0, 1.0 + 0.45 * C.easeOut(u))
+    }
+
+    /// One four-point sparkle: translated (pt, from the tile's centre), turned (degrees), scaled.
+    public struct Sparkle: Equatable {
+        public var opacity: Double
+        public var x: Double
+        public var y: Double
+        public var rotation: Double
+        public var scale: Double
+    }
+
+    /// `fx.sparkles(t, t0, n, c)`: n sparkles fly out of the tile and fade.
+    public static func sparkles(_ t: Double, _ t0: Double, _ n: Int) -> [Sparkle] {
+        let u = (t - t0) / 0.6
+        var result: [Sparkle] = []
+        for i in 0 ..< n {
+            let fi = Double(i)
+            let a = (fi / Double(n)) * 360.0 + 20.0 * sin(fi * 7.1)
+            let d = 22.0 + 6.0 * sin(fi * 3.3)
+            let k = 0.8 + 0.3 * cos(fi * 5.1)
+            let v = C.clamp(u * k)
+            let r = d * C.easeOut(v)
+            result.append(Sparkle(
+                opacity: v > 0.0 && v < 1.0 ? sin(Double.pi * v) : 0.0,
+                x: cos(a * degree) * r,
+                y: sin(a * degree) * r,
+                rotation: v * 90.0,
+                scale: 0.4 + 0.8 * sin(Double.pi * v)
+            ))
+        }
+        return result
+    }
+
+    /// The confetti's colours, piece i taking `confettiColors[i % 6]`.
+    public static let confettiColors: [UInt32] = [0xffd84a, 0xff6b8a, 0x6ee7ff, 0x8cff7a, 0xc79bff, 0xffffff]
+
+    /// One piece of confetti (4 × 6 pt, from 42 % of the tile's height); `isLaunched` is false until
+    /// `t0`, when it is not drawn yet.
+    public struct Confetto: Equatable {
+        public var isLaunched: Bool
+        public var opacity: Double
+        public var x: Double
+        public var y: Double
+        public var rotation: Double
+    }
+
+    /// `fx.confetti(t, t0)`: nine pieces thrown up and out under gravity, spinning and fading.
+    public static func confetti(_ t: Double, _ t0: Double) -> [Confetto] {
+        let u = t - t0
+        var result: [Confetto] = []
+        for i in 0 ..< 9 {
+            let fi = Double(i)
+            if u <= 0.0 {
+                result.append(Confetto(isLaunched: false, opacity: 0.0, x: 0.0, y: 0.0, rotation: 0.0))
+                continue
+            }
+            let vx = (fi - 4.0) * 26.0 + 10.0 * sin(fi * 2.7)
+            let vy = -150.0 - 40.0 * cos(fi * 1.9)
+            let spin = (i % 2 != 0 ? 1.0 : -1.0) * (400.0 + 90.0 * fi)
+            result.append(Confetto(
+                isLaunched: true,
+                opacity: C.clamp(1.4 - u * 1.6),
+                x: vx * u,
+                y: vy * u + 0.5 * 520.0 * u * u,
+                rotation: spin * u
+            ))
+        }
+        return result
+    }
+
+    /// `fx.dots(t, t0)`: the bubble's own three dots (cut out of it) bounce in turn — typing — until 1.05 s:
+    /// each one's vertical offset (pt, up is negative).
+    public static func dots(_ t: Double, _ t0: Double) -> [Double] {
+        var result: [Double] = []
+        for i in 0 ..< 3 {
+            let u = t - t0 - Double(i) * 0.12
+            let on = u > 0.0 && t < 1.05
+            result.append(on ? -1.4 * max(0.0, sin(2.0 * Double.pi * 2.2 * u)) : 0.0)
+        }
+        return result
+    }
+
+    /// `fx.rays(t, t0)`: the five rays over the lamp, all at this opacity.
+    public static func rays(_ t: Double, _ t0: Double) -> Double {
+        let u = C.clamp((t - t0) / 0.6)
+        return u > 0.0 && u < 1.0 ? sin(Double.pi * u) : 0.0
+    }
+
+    /// `fx.stroke(t, t0)`: the brush's paint stroke drawn (`stroke-dashoffset`, path length 1) and faded.
+    public static func stroke(_ t: Double, _ t0: Double) -> (dashOffset: Double, opacity: Double) {
+        let draw = C.clamp((t - t0) / 0.25)
+        let fade = C.clamp((t - 0.75) / 0.25)
+        return (1.0 - C.ease(draw), draw <= 0.001 ? 0.0 : 1.0 - fade)
+    }
+
+    /// `fx.paper(open)`: the sheet rising out of the folder as its flap opens (its top `y`, opacity).
+    public static func paper(_ open: Double) -> (y: Double, opacity: Double) {
+        return (14.0 - 6.5 * open, 0.92 * C.clamp(open * 3.0))
+    }
+
+    /// `fx.flash(t, t0)`: the camera's flash, a disc growing out of the lens and fading.
+    public static func flash(_ t: Double, _ t0: Double) -> (opacity: Double, radius: Double) {
+        let u = C.clamp((t - t0) / 0.35)
+        return (u > 0.0 && u < 1.0 ? (1.0 - u) * 0.9 : 0.0, 4.0 + 4.0 * C.easeOut(u))
+    }
+
+    /// `fx.hue(t, d)`: `hue-rotate(degrees) saturate(1.4)` over the glyph, nil outside the turn.
+    public static func hue(_ t: Double, _ d: Double) -> Double? {
+        let u = C.clamp(t / d)
+        return u > 0.0 && u < 1.0 ? 360.0 * C.ease(u) : nil
+    }
+
+    /// The saturation `fx.hue` adds while it turns.
+    public static let hueSaturation: Double = 1.4
+
+    /// `fx.spin3d(t, t0, d)`: `perspective(60px) rotateY(degrees)`, a full turn (ease in-out), nil outside it.
+    public static func spin3d(_ t: Double, _ t0: Double, _ d: Double) -> Double? {
+        let u = C.clamp((t - t0) / d)
+        let a = 360.0 * (u < 0.5 ? 4.0 * u * u * u : 1.0 - pow(-2.0 * u + 2.0, 3.0) / 2.0)
+        return u > 0.0 && u < 1.0 ? a : nil
+    }
+
+    /// `perspective(60px)` of `fx.spin3d`.
+    public static let spinPerspective: Double = 60.0
+
+    /// `fx.globe(u)`: from the meridian at rest (rx 3.9 on the rig's 8.6 globe) round to it again; the second
+    /// meridian, a quarter turn behind, fades in and out so neither end jumps. Half-widths of the two meridians
+    /// on that globe (`LivingIconArtwork.TurningGlobe.meridianScale` takes them to Telegram's) and the second's
+    /// opacity.
+    public static func globe(_ u: Double) -> (rx0: Double, rx1: Double, opacity1: Double) {
+        let th = acos(3.9 / 8.6) + u * 2.0 * Double.pi
+        let rx0 = u >= 1.0 ? 3.9 : 8.6 * abs(cos(th))
+        return (rx0, 8.6 * abs(sin(th)), C.clamp(u / 0.12) * C.clamp((1.0 - u) / 0.12))
+    }
+
+    /// `fx.globe`'s cross-fade at the rig's time `t`: how much of the turning globe shows over Telegram's banded
+    /// one (0 at rest) — in from the start, out over the rig's last moments.
+    public static func globeCrossFade(_ t: Double, duration: Double) -> Double {
+        typealias G = LivingIconArtwork.TurningGlobe
+        return C.clamp(t / G.fadeIn) * C.clamp((duration - t) / G.fadeOut)
+    }
+
+    /// The CSS `hue-rotate(degrees) saturate(s)` filter applied to one sRGB colour (Filter Effects 1,
+    /// §13.1.2 feColorMatrix "hueRotate" and "saturate", in that order; channels 0…1, clamped).
+    public static func filterColor(red: Double, green: Double, blue: Double, hueDegrees: Double, saturation: Double) -> (red: Double, green: Double, blue: Double) {
+        let a = hueDegrees * degree
+        let c = cos(a)
+        let s = sin(a)
+        let h: [Double] = [
+            0.213 + c * 0.787 - s * 0.213, 0.715 - c * 0.715 - s * 0.715, 0.072 - c * 0.072 + s * 0.928,
+            0.213 - c * 0.213 + s * 0.143, 0.715 + c * 0.285 + s * 0.140, 0.072 - c * 0.072 - s * 0.283,
+            0.213 - c * 0.213 - s * 0.787, 0.715 - c * 0.715 + s * 0.715, 0.072 + c * 0.928 + s * 0.072,
+        ]
+        let r1 = C.clamp(h[0] * red + h[1] * green + h[2] * blue)
+        let g1 = C.clamp(h[3] * red + h[4] * green + h[5] * blue)
+        let b1 = C.clamp(h[6] * red + h[7] * green + h[8] * blue)
+        let k = saturation
+        let r2 = (0.213 + 0.787 * k) * r1 + (0.715 - 0.715 * k) * g1 + (0.072 - 0.072 * k) * b1
+        let g2 = (0.213 - 0.213 * k) * r1 + (0.715 + 0.285 * k) * g1 + (0.072 - 0.072 * k) * b1
+        let b2 = (0.213 - 0.213 * k) * r1 + (0.715 - 0.715 * k) * g1 + (0.072 + 0.928 * k) * b1
+        return (C.clamp(r2), C.clamp(g2), C.clamp(b2))
+    }
+}
diff --git a/submodules/TelegramUI/Components/PeerInfo/LivingSettingsIcons/Sources/LivingIconImageSplit.swift b/submodules/TelegramUI/Components/PeerInfo/LivingSettingsIcons/Sources/LivingIconImageSplit.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/LivingSettingsIcons/Sources/LivingIconImageSplit.swift
@@ -0,0 +1,103 @@
+import Foundation
+import CoreGraphics
+
+// Money's icon is a bitmap (Telegram-iOS "Settings/Gram": a flat-coloured gem with a white sparkle), while the
+// money rig turns the sparkle on its own (`E.inner`, living-icons.js `RIGS.money`). This splits the bitmap into
+// the gem (the sparkle's pixels filled with the gem's colour) and the sparkle (white, with the coverage it had),
+// so that the sparkle drawn over the gem is exactly the bitmap again. Pure CoreGraphics. (The prototype draws the
+// same two images, split the same way by tools/telegram-money.mjs.)
+
+public enum LivingIconImageSplit {
+    public struct Result {
+        /// The image without its sparkle.
+        public let base: CGImage
+        /// The sparkle: white, premultiplied by its coverage.
+        public let sparkle: CGImage
+        /// The sparkle's centre (coverage-weighted), in pixels from the top-left.
+        public let center: CGPoint
+    }
+
+    /// Splits a flat-coloured shape with a white mark on it. Every opaque pixel is the shape's colour mixed with
+    /// white by a coverage `s`; the shape's colour is the commonest opaque colour. Returns nil if there is no mark.
+    public static func split(_ image: CGImage) -> Result? {
+        let width = image.width
+        let height = image.height
+        guard width > 0, height > 0, width * height <= 1_000_000 else {
+            return nil
+        }
+        let bytesPerRow = width * 4
+        var pixels = [UInt8](repeating: 0, count: bytesPerRow * height)
+        let colorSpace = CGColorSpaceCreateDeviceRGB()
+        let bitmapInfo = CGImageAlphaInfo.premultipliedLast.rawValue
+        let drawn: Bool = pixels.withUnsafeMutableBytes { buffer in
+            guard let context = CGContext(data: buffer.baseAddress, width: width, height: height, bitsPerComponent: 8, bytesPerRow: bytesPerRow, space: colorSpace, bitmapInfo: bitmapInfo) else {
+                return false
+            }
+            context.draw(image, in: CGRect(x: 0, y: 0, width: width, height: height))
+            return true
+        }
+        guard drawn else {
+            return nil
+        }
+
+        // The shape's colour: the commonest fully opaque colour.
+        var counts: [UInt32: Int] = [:]
+        for i in stride(from: 0, to: pixels.count, by: 4) where pixels[i + 3] == 255 {
+            let key = UInt32(pixels[i]) << 16 | UInt32(pixels[i + 1]) << 8 | UInt32(pixels[i + 2])
+            counts[key, default: 0] += 1
+        }
+        guard let shape = counts.max(by: { $0.value < $1.value })?.key else {
+            return nil
+        }
+        let shapeColor = [Double((shape >> 16) & 0xff), Double((shape >> 8) & 0xff), Double(shape & 0xff)]
+        // Measure the mix on the channel farthest from white.
+        let channel = (0 ..< 3).min(by: { shapeColor[$0] < shapeColor[$1] }) ?? 0
+        let span = 255.0 - shapeColor[channel]
+        guard span > 32.0 else {
+            return nil
+        }
+
+        var base = pixels
+        var sparkle = [UInt8](repeating: 0, count: pixels.count)
+        var weight = 0.0
+        var sumX = 0.0
+        var sumY = 0.0
+        for y in 0 ..< height {
+            for x in 0 ..< width {
+                let i = y * bytesPerRow + x * 4
+                guard pixels[i + 3] == 255 else {
+                    continue
+                }
+                let s = max(0.0, min(1.0, (Double(pixels[i + channel]) - shapeColor[channel]) / span))
+                if s <= 0.02 {
+                    continue
+                }
+                base[i] = UInt8(shapeColor[0])
+                base[i + 1] = UInt8(shapeColor[1])
+                base[i + 2] = UInt8(shapeColor[2])
+                let value = UInt8((s * 255.0).rounded())
+                sparkle[i] = value
+                sparkle[i + 1] = value
+                sparkle[i + 2] = value
+                sparkle[i + 3] = value
+                weight += s
+                sumX += s * (Double(x) + 0.5)
+                sumY += s * (Double(y) + 0.5)
+            }
+        }
+        guard weight > 1.0 else {
+            return nil
+        }
+
+        func makeImage(_ bytes: [UInt8]) -> CGImage? {
+            guard let provider = CGDataProvider(data: Data(bytes) as CFData) else {
+                return nil
+            }
+            return CGImage(width: width, height: height, bitsPerComponent: 8, bitsPerPixel: 32, bytesPerRow: bytesPerRow, space: colorSpace, bitmapInfo: CGBitmapInfo(rawValue: bitmapInfo), provider: provider, decode: nil, shouldInterpolate: true, intent: .defaultIntent)
+        }
+        guard let baseImage = makeImage(base), let sparkleImage = makeImage(sparkle) else {
+            return nil
+        }
+        return Result(base: baseImage, sparkle: sparkleImage, center: CGPoint(x: sumX / weight, y: sumY / weight))
+    }
+}
diff --git a/submodules/TelegramUI/Components/PeerInfo/LivingSettingsIcons/Sources/LivingIconPath.swift b/submodules/TelegramUI/Components/PeerInfo/LivingSettingsIcons/Sources/LivingIconPath.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramUI/Components/PeerInfo/LivingSettingsIcons/Sources/LivingIconPath.swift
@@ -0,0 +1,314 @@
+import Foundation
+import CoreGraphics
+
+// SVG path data → CGPath, for the icon artwork (prototype/assets/icons/*.svg and the part geometry of
+// prototype/src/settings/living-icons.js). All commands of SVG 1.1 §8.3 (M L H V C S Q T A Z, absolute
+// and relative, implicit repeats); arcs become cubic Béziers (≤ 90° each, SVG 1.1 F.6.5-F.6.6).
+// `subpaths` splits the data at every moveto like the prototype's `splitSubpaths` (a piece per
+// `M`/`m`), but each piece keeps the absolute position the full path gives it.
+
+public enum LivingIconPath {
+    /// The whole path.
+    public static func path(_ d: String) -> CGPath {
+        let path = CGMutablePath()
+        for subpath in self.subpaths(d) {
+            path.addPath(subpath)
+        }
+        return path
+    }
+
+    /// One path per moveto, in order (a lone moveto gives an empty path, as it draws nothing).
+    public static func subpaths(_ d: String) -> [CGPath] {
+        var parser = Parser(Array(d.utf8))
+        return parser.parse()
+    }
+
+    /// The path of an SVG `<circle>`.
+    public static func circle(cx: Double, cy: Double, r: Double) -> CGPath {
+        return CGPath(ellipseIn: CGRect(x: cx - r, y: cy - r, width: 2.0 * r, height: 2.0 * r), transform: nil)
+    }
+
+    private struct Parser {
+        let bytes: [UInt8]
+        var index = 0
+
+        init(_ bytes: [UInt8]) {
+            self.bytes = bytes
+        }
+
+        private static func isCommand(_ c: UInt8) -> Bool {
+            switch c {
+            case UInt8(ascii: "M"), UInt8(ascii: "m"), UInt8(ascii: "L"), UInt8(ascii: "l"), UInt8(ascii: "H"), UInt8(ascii: "h"),
+                 UInt8(ascii: "V"), UInt8(ascii: "v"), UInt8(ascii: "C"), UInt8(ascii: "c"), UInt8(ascii: "S"), UInt8(ascii: "s"),
+                 UInt8(ascii: "Q"), UInt8(ascii: "q"), UInt8(ascii: "T"), UInt8(ascii: "t"), UInt8(ascii: "A"), UInt8(ascii: "a"),
+                 UInt8(ascii: "Z"), UInt8(ascii: "z"):
+                return true
+            default:
+                return false
+            }
+        }
+
+        private mutating func skipSeparators() {
+            while self.index < self.bytes.count {
+                let c = self.bytes[self.index]
+                if c == UInt8(ascii: " ") || c == UInt8(ascii: ",") || c == UInt8(ascii: "\n") || c == UInt8(ascii: "\t") || c == UInt8(ascii: "\r") {
+                    self.index += 1
+                } else {
+                    break
+                }
+            }
+        }
+
+        /// Whether a number follows (after separators).
+        private mutating func hasNumber() -> Bool {
+            self.skipSeparators()
+            guard self.index < self.bytes.count else {
+                return false
+            }
+            let c = self.bytes[self.index]
+            return (c >= UInt8(ascii: "0") && c <= UInt8(ascii: "9")) || c == UInt8(ascii: "-") || c == UInt8(ascii: "+") || c == UInt8(ascii: ".")
+        }
+
+        private mutating func number() -> Double {
+            self.skipSeparators()
+            let start = self.index
+            if self.index < self.bytes.count, self.bytes[self.index] == UInt8(ascii: "-") || self.bytes[self.index] == UInt8(ascii: "+") {
+                self.index += 1
+            }
+            var seenDot = false
+            while self.index < self.bytes.count {
+                let c = self.bytes[self.index]
+                if c >= UInt8(ascii: "0") && c <= UInt8(ascii: "9") {
+                    self.index += 1
+                } else if c == UInt8(ascii: ".") && !seenDot {
+                    seenDot = true
+                    self.index += 1
+                } else {
+                    break
+                }
+            }
+            if self.index < self.bytes.count, self.bytes[self.index] == UInt8(ascii: "e") || self.bytes[self.index] == UInt8(ascii: "E") {
+                var j = self.index + 1
+                if j < self.bytes.count, self.bytes[j] == UInt8(ascii: "-") || self.bytes[j] == UInt8(ascii: "+") {
+                    j += 1
+                }
+                if j < self.bytes.count, self.bytes[j] >= UInt8(ascii: "0") && self.bytes[j] <= UInt8(ascii: "9") {
+                    self.index = j
+                    while self.index < self.bytes.count, self.bytes[self.index] >= UInt8(ascii: "0") && self.bytes[self.index] <= UInt8(ascii: "9") {
+                        self.index += 1
+                    }
+                }
+            }
+            guard self.index > start, let value = Double(String(decoding: self.bytes[start ..< self.index], as: UTF8.self)) else {
+                self.index = max(self.index, start + 1)
+                return 0.0
+            }
+            return value
+        }
+
+        /// An arc flag: a single 0 or 1, which may run into the next number ("a1 1 0 01.5 1").
+        private mutating func flag() -> Bool {
+            self.skipSeparators()
+            guard self.index < self.bytes.count else {
+                return false
+            }
+            let c = self.bytes[self.index]
+            self.index += 1
+            return c == UInt8(ascii: "1")
+        }
+
+        mutating func parse() -> [CGPath] {
+            var result: [CGPath] = []
+            var current: CGMutablePath?
+            var command: UInt8 = 0
+            var x = 0.0
+            var y = 0.0
+            var startX = 0.0
+            var startY = 0.0
+            // The last control point, for S/s (cubic) and T/t (quadratic) reflections.
+            var lastCubic: (Double, Double)?
+            var lastQuad: (Double, Double)?
+
+            func ensure() -> CGMutablePath {
+                if let current = current {
+                    return current
+                }
+                let path = CGMutablePath()
+                path.move(to: CGPoint(x: x, y: y))
+                current = path
+                result.append(path)
+                return path
+            }
+
+            while true {
+                self.skipSeparators()
+                guard self.index < self.bytes.count else {
+                    break
+                }
+                let c = self.bytes[self.index]
+                if Parser.isCommand(c) {
+                    command = c
+                    self.index += 1
+                } else if command == 0 || !self.hasNumber() {
+                    // Not path data: stop rather than loop.
+                    break
+                }
+                let relative = command >= UInt8(ascii: "a") && command <= UInt8(ascii: "z")
+                let ox = relative ? x : 0.0
+                let oy = relative ? y : 0.0
+                switch command {
+                case UInt8(ascii: "M"), UInt8(ascii: "m"):
+                    x = self.number() + ox
+                    y = self.number() + oy
+                    let path = CGMutablePath()
+                    path.move(to: CGPoint(x: x, y: y))
+                    current = path
+                    result.append(path)
+                    startX = x
+                    startY = y
+                    // Pairs after a moveto are linetos.
+                    command = relative ? UInt8(ascii: "l") : UInt8(ascii: "L")
+                    lastCubic = nil
+                    lastQuad = nil
+                case UInt8(ascii: "L"), UInt8(ascii: "l"):
+                    x = self.number() + ox
+                    y = self.number() + oy
+                    ensure().addLine(to: CGPoint(x: x, y: y))
+                    lastCubic = nil
+                    lastQuad = nil
+                case UInt8(ascii: "H"), UInt8(ascii: "h"):
+                    x = self.number() + ox
+                    ensure().addLine(to: CGPoint(x: x, y: y))
+                    lastCubic = nil
+                    lastQuad = nil
+                case UInt8(ascii: "V"), UInt8(ascii: "v"):
+                    y = self.number() + oy
+                    ensure().addLine(to: CGPoint(x: x, y: y))
+                    lastCubic = nil
+                    lastQuad = nil
+                case UInt8(ascii: "C"), UInt8(ascii: "c"):
+                    let x1 = self.number() + ox
+                    let y1 = self.number() + oy
+                    let x2 = self.number() + ox
+                    let y2 = self.number() + oy
+                    x = self.number() + ox
+                    y = self.number() + oy
+                    ensure().addCurve(to: CGPoint(x: x, y: y), control1: CGPoint(x: x1, y: y1), control2: CGPoint(x: x2, y: y2))
+                    lastCubic = (x2, y2)
+                    lastQuad = nil
+                case UInt8(ascii: "S"), UInt8(ascii: "s"):
+                    let x1 = lastCubic.map { 2.0 * x - $0.0 } ?? x
+                    let y1 = lastCubic.map { 2.0 * y - $0.1 } ?? y
+                    let x2 = self.number() + ox
+                    let y2 = self.number() + oy
+                    x = self.number() + ox
+                    y = self.number() + oy
+                    ensure().addCurve(to: CGPoint(x: x, y: y), control1: CGPoint(x: x1, y: y1), control2: CGPoint(x: x2, y: y2))
+                    lastCubic = (x2, y2)
+                    lastQuad = nil
+                case UInt8(ascii: "Q"), UInt8(ascii: "q"):
+                    let qx = self.number() + ox
+                    let qy = self.number() + oy
+                    x = self.number() + ox
+                    y = self.number() + oy
+                    ensure().addQuadCurve(to: CGPoint(x: x, y: y), control: CGPoint(x: qx, y: qy))
+                    lastQuad = (qx, qy)
+                    lastCubic = nil
+                case UInt8(ascii: "T"), UInt8(ascii: "t"):
+                    let qx = lastQuad.map { 2.0 * x - $0.0 } ?? x
+                    let qy = lastQuad.map { 2.0 * y - $0.1 } ?? y
+                    x = self.number() + ox
+                    y = self.number() + oy
+                    ensure().addQuadCurve(to: CGPoint(x: x, y: y), control: CGPoint(x: qx, y: qy))
+                    lastQuad = (qx, qy)
+                    lastCubic = nil
+                case UInt8(ascii: "A"), UInt8(ascii: "a"):
+                    let rx = self.number()
+                    let ry = self.number()
+                    let phi = self.number()
+                    let largeArc = self.flag()
+                    let sweep = self.flag()
+                    let x2 = self.number() + ox
+                    let y2 = self.number() + oy
+                    Parser.addArc(ensure(), from: (x, y), to: (x2, y2), rx: rx, ry: ry, phi: phi, largeArc: largeArc, sweep: sweep)
+                    x = x2
+                    y = y2
+                    lastCubic = nil
+                    lastQuad = nil
+                case UInt8(ascii: "Z"), UInt8(ascii: "z"):
+                    // A command after it that is not a moveto starts a new subpath at the start point,
+                    // in the same piece (the prototype splits at movetos only).
+                    ensure().closeSubpath()
+                    x = startX
+                    y = startY
+                    lastCubic = nil
+                    lastQuad = nil
+                    command = 0
+                default:
+                    break
+                }
+            }
+            return result
+        }
+
+        /// SVG 1.1 F.6.5 (endpoint → centre parameterization) and cubic segments of at most 90°.
+        static func addArc(_ path: CGMutablePath, from p1: (Double, Double), to p2: (Double, Double), rx rxIn: Double, ry ryIn: Double, phi: Double, largeArc: Bool, sweep: Bool) {
+            if p1.0 == p2.0 && p1.1 == p2.1 {
+                return
+            }
+            var rx = abs(rxIn)
+            var ry = abs(ryIn)
+            if rx == 0.0 || ry == 0.0 {
+                path.addLine(to: CGPoint(x: p2.0, y: p2.1))
+                return
+            }
+            let rad = phi * Double.pi / 180.0
+            let cosPhi = cos(rad)
+            let sinPhi = sin(rad)
+            let dx = (p1.0 - p2.0) / 2.0
+            let dy = (p1.1 - p2.1) / 2.0
+            let x1p = cosPhi * dx + sinPhi * dy
+            let y1p = -sinPhi * dx + cosPhi * dy
+            let lambda = (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry)
+            if lambda > 1.0 {
+                rx *= sqrt(lambda)
+                ry *= sqrt(lambda)
+            }
+            let numerator = rx * rx * ry * ry - rx * rx * y1p * y1p - ry * ry * x1p * x1p
+            let denominator = rx * rx * y1p * y1p + ry * ry * x1p * x1p
+            var coefficient = denominator == 0.0 ? 0.0 : sqrt(max(0.0, numerator / denominator))
+            if largeArc == sweep {
+                coefficient = -coefficient
+            }
+            let cxp = coefficient * rx * y1p / ry
+            let cyp = -coefficient * ry * x1p / rx
+            let cx = cosPhi * cxp - sinPhi * cyp + (p1.0 + p2.0) / 2.0
+            let cy = sinPhi * cxp + cosPhi * cyp + (p1.1 + p2.1) / 2.0
+            func angle(_ ux: Double, _ uy: Double, _ vx: Double, _ vy: Double) -> Double {
+                return atan2(ux * vy - uy * vx, ux * vx + uy * vy)
+            }
+            let theta1 = angle(1.0, 0.0, (x1p - cxp) / rx, (y1p - cyp) / ry)
+            var delta = angle((x1p - cxp) / rx, (y1p - cyp) / ry, (-x1p - cxp) / rx, (-y1p - cyp) / ry)
+            if !sweep && delta > 0.0 {
+                delta -= 2.0 * Double.pi
+            } else if sweep && delta < 0.0 {
+                delta += 2.0 * Double.pi
+            }
+            let segments = max(1, Int(ceil(abs(delta) / (Double.pi / 2.0) - 1e-9)))
+            let step = delta / Double(segments)
+            let k = 4.0 / 3.0 * tan(step / 4.0)
+            func map(_ ux: Double, _ uy: Double) -> CGPoint {
+                return CGPoint(x: cx + rx * ux * cosPhi - ry * uy * sinPhi, y: cy + rx * ux * sinPhi + ry * uy * cosPhi)
+            }
+            var a = theta1
+            for i in 0 ..< segments {
+                let b = theta1 + step * Double(i + 1)
+                let c1 = map(cos(a) - k * sin(a), sin(a) + k * cos(a))
+                let c2 = map(cos(b) + k * sin(b), sin(b) - k * cos(b))
+                let end = i == segments - 1 ? CGPoint(x: p2.0, y: p2.1) : map(cos(b), sin(b))
+                path.addCurve(to: end, control1: c1, control2: c2)
+                a = b
+            }
+        }
+    }
+}
