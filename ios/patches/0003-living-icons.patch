+    static let avatar = LivingIconRig(duration: 1.0) { t, P, fx, _ in
+        let s = 1.0 - 0.1 * sin(Double.pi * C.clamp(t / 0.16)) + C.ring(t, 0.04, 4.0, 6.0, 0.16)
