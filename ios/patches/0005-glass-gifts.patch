diff --git a/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftGestureRecognizer.swift b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftGestureRecognizer.swift
