index 0000000..89cc48d
--- /dev/null
+++ b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftGestureRecognizer.swift
@@ -0,0 +1,273 @@
+import Foundation
+import UIKit
+import UIKit.UIGestureRecognizerSubclass
+import Display
+
+/// The glass's touch on a gift tile (prototype/src/profile/profile-page.js `down` / `move` / `up`), without taking
+/// anything away from what a tile already does:
+///
+/// · **touch down** leans the glass toward the finger and runs a burst of light across it at once, but the recognizer
+///   stays `.possible`: the tile's button still gets the touch, and a **tap still opens the gift's info sheet**
+///   (the recognizer fails when the finger lifts). The finger moving within the tile keeps the lean on it.
+/// · a move past 8 pt before the hold is a scroll or a tab swipe: the recognizer fails and the glass eases home; the
+///   pane's own pan has the touch as before (if a pan starts sooner, it fails the recognizer itself).
+/// · after the **hold** — the context gesture's own threshold (`beginDelay`, 0.12 s) within 10 pt — a slide belongs to
+///   the tiles: the pans of the views around (the pane's scroll, the tab paging, the back swipe) are failed, as the
+///   context gesture does when its menu opens (`cancelParentGestures`). Lifting the finger without sliding is still a
+///   tap; holding still is still the context menu (its press shrink composes with the glass).
+/// · a slide of 10 pt after the hold **inspects**: the recognizer begins (the button's tap is cancelled, the context
+///   gesture too), and every tile the finger crosses leans after it with a burst and a selection tick.
+/// · the context menu opening fails the recognizer (`cancelParentGestures`); every way out releases the glass, which
+///   eases home.
+/// A touch that stops a scrolling grid only catches it (no lean, no burst).
+final class GlassGiftGestureRecognizer: UIGestureRecognizer {
+    private enum Phase {
+        case idle
+        /// Down, before the hold: the lean follows the finger on its tile.
+        case pending
+        /// Held still past the context gesture's threshold: a slide now inspects.
+        case armed
+        /// Sliding across the tiles.
+        case inspecting
+    }
+
+    /// prototype: a move past 8 pt before the hold scrolls.
+    static let scrollSlop: CGFloat = 8.0
+    /// prototype: the hold counts within 10 pt; here also the slide that starts inspecting.
+    static let holdSlop: CGFloat = 10.0
+
+    weak var tile: GlassGiftTile?
+
+    private var phase: Phase = .idle
+    private weak var trackedTouch: UITouch?
+    private var startPoint = CGPoint()
+    private var holdTimer: Timer?
+    /// The tile under the finger while inspecting (nil between tiles).
+    private weak var heldTile: GlassGiftTile?
+    private let hapticFeedback = HapticFeedback()
+
+    override init(target: Any?, action: Selector?) {
+        super.init(target: target, action: action)
+        // Never hold the tile's own touches back; cancel them only once inspecting begins.
+        self.cancelsTouchesInView = true
+        self.delaysTouchesBegan = false
+        self.delaysTouchesEnded = false
+    }
+
+    deinit {
+        self.holdTimer?.invalidate()
+    }
+
+    override var state: UIGestureRecognizer.State {
+        didSet {
+            switch self.state {
+            case .ended, .cancelled, .failed:
+                // However the touch ends — lifted, a scroll or the context menu took it — the glass eases home.
+                self.finish()
+            default:
+                break
+            }
+        }
+    }
+
+    override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+        super.touchesBegan(touches, with: event)
+        guard self.phase == .idle else {
+            // A second finger: the first one keeps the glass.
+            return
+        }
+        guard let touch = touches.first, let view = self.view, let tile = self.tile else {
+            self.state = .failed
+            return
+        }
+        if GlassGiftGestureRecognizer.isInScrollingView(view) {
+            // prototype `caught`: this touch stops the scroll.
+            self.state = .failed
+            return
+        }
+        self.trackedTouch = touch
+        self.startPoint = touch.location(in: view)
+        self.phase = .pending
+        tile.touchDown(at: self.startPoint)
+
+        let delay = (view as? ContextControllerSourceView)?.beginDelay ?? 0.12
+        let timer = Timer(timeInterval: delay, repeats: false, block: { [weak self] _ in
+            self?.holdTimerFired()
+        })
+        self.holdTimer = timer
+        RunLoop.main.add(timer, forMode: .common)
+    }
+
+    override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent) {
+        super.touchesMoved(touches, with: event)
+        guard let touch = self.trackedTouch, touches.contains(touch), let view = self.view else {
+            return
+        }
+        let point = touch.location(in: view)
+        let distance = hypot(point.x - self.startPoint.x, point.y - self.startPoint.y)
+        switch self.phase {
+        case .idle:
+            break
+        case .pending:
+            if distance > GlassGiftGestureRecognizer.scrollSlop {
+                self.state = .failed
+            } else {
+                self.tile?.aim(at: point)
+            }
+        case .armed:
+            if distance >= GlassGiftGestureRecognizer.holdSlop {
+                self.beginInspecting(touch: touch)
+            } else {
+                self.tile?.aim(at: point)
+            }
+        case .inspecting:
+            self.state = .changed
+            if self.inspect(touch: touch) {
+                self.hapticFeedback.tap()
+            }
+        }
+    }
+
+    override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent) {
+        super.touchesEnded(touches, with: event)
+        guard let touch = self.trackedTouch, touches.contains(touch) else {
+            return
+        }
+        if self.phase == .inspecting {
+            self.state = .ended
+        } else {
+            // A tap (or a press released before the menu): the button below opens the info sheet.
+            self.state = .failed
+        }
+    }
+
+    override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent) {
+        super.touchesCancelled(touches, with: event)
+        guard let touch = self.trackedTouch, touches.contains(touch) else {
+            return
+        }
+        self.state = self.phase == .inspecting ? .cancelled : .failed
+    }
+
+    override func reset() {
+        self.finish()
+        super.reset()
+    }
+
+    private func holdTimerFired() {
+        self.holdTimer = nil
+        guard self.phase == .pending, self.state == .possible, let view = self.view else {
+            return
+        }
+        if GlassGiftGestureRecognizer.hasActivePan(above: view) {
+            // A scroll or a swipe already has the touch.
+            self.state = .failed
+            return
+        }
+        self.phase = .armed
+        self.hapticFeedback.prepareTap()
+        // From here on a slide is the tiles': nothing around scrolls, pages or swipes back with this touch.
+        GlassGiftGestureRecognizer.failPans(above: view)
+    }
+
+    private func beginInspecting(touch: UITouch) {
+        self.phase = .inspecting
+        self.heldTile = self.tile
+        self.state = .began
+        // No context menu: the finger slides on.
+        (self.view as? ContextControllerSourceView)?.cancelGesture()
+        // One tick for the start, whichever tile the finger is over by now.
+        self.inspect(touch: touch)
+        self.hapticFeedback.tap()
+    }
+
+    /// The tile under the finger leans after it; crossing onto another one bursts it. True when the tile changed to a
+    /// new one.
+    @discardableResult
+    private func inspect(touch: UITouch) -> Bool {
+        guard let view = self.view, let container = view.superview else {
+            return false
+        }
+        let found = GlassGiftGestureRecognizer.tile(at: touch.location(in: container), in: container)
+        var enteredTile = false
+        if found?.tile !== self.heldTile {
+            self.heldTile?.release()
+            self.heldTile = found?.tile
+            if let found {
+                found.tile.burst()
+                enteredTile = true
+            }
+        }
+        if let found {
+            found.tile.aim(at: touch.location(in: found.view))
+        }
+        return enteredTile
+    }
+
+    private func finish() {
+        self.holdTimer?.invalidate()
+        self.holdTimer = nil
+        let phase = self.phase
+        self.phase = .idle
+        self.trackedTouch = nil
+        switch phase {
+        case .idle:
+            break
+        case .pending, .armed:
+            self.tile?.release()
+        case .inspecting:
+            // Every tile the finger left was released as it left; the one under it now eases home too.
+            self.heldTile?.release()
+        }
+        self.heldTile = nil
+    }
+
+    /// The glass tile whose view contains `point` (in `container`, the grid), if any.
+    static func tile(at point: CGPoint, in container: UIView) -> (tile: GlassGiftTile, view: UIView)? {
+        for view in container.subviews.reversed() where !view.isHidden && view.alpha > 0.01 && view.frame.contains(point) {
+            guard let recognizers = view.gestureRecognizers else {
+                continue
+            }
+            for recognizer in recognizers {
+                if let recognizer = recognizer as? GlassGiftGestureRecognizer, let tile = recognizer.tile {
+                    return (tile, view)
+                }
+            }
+        }
+        return nil
+    }
+
+    private static func isInScrollingView(_ view: UIView) -> Bool {
+        var current = view.superview
+        while let view = current {
+            if let scrollView = view as? UIScrollView, scrollView.isDecelerating {
+                return true
+            }
+            current = view.superview
+        }
+        return false
+    }
+
+    private static func hasActivePan(above view: UIView) -> Bool {
+        var current = view.superview
+        while let view = current {
+            for recognizer in view.gestureRecognizers ?? [] where recognizer is UIPanGestureRecognizer {
+                if recognizer.state == .began || recognizer.state == .changed {
+                    return true
+                }
+            }
+            current = view.superview
+        }
+        return false
+    }
+
+    private static func failPans(above view: UIView) {
+        var current = view.superview
+        while let view = current {
+            for recognizer in view.gestureRecognizers ?? [] where recognizer is UIPanGestureRecognizer && recognizer.isEnabled && recognizer.state == .possible {
+                recognizer.state = .failed
+            }
+            current = view.superview
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftMotion.swift b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftMotion.swift
new file mode 100644
index 0000000..1a33527
--- /dev/null
+++ b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftMotion.swift
@@ -0,0 +1,267 @@
+import Foundation
+import UIKit
+import CoreMotion
+
+/// The phone's tilt for every gift tile on screen: one shared Core Motion source (prototype/src/profile/glass-gifts.js
+/// `MotionSource`, filtered by `GlassGiftMotionFilter`).
+///
+/// The tilt moves the light — the sheen, the prismatic streak and the lit edge — across all tiles at once, with only a
+/// hint of lean. Like the TON wallet card's motion (WalletCardComponent.swift:938-973) it runs only while it is seen:
+/// · a **client** is a gifts pane (`PeerInfoGiftsPaneNode`) that holds a `Client` while it is in the window; the
+///   sensor runs while at least one client's view is on screen. A pane that is in the window but off screen (the tab
+///   next to the selected one) puts the source on standby: the sensor stops and the source looks again twice a second.
+///   With no client at all nothing runs.
+/// · **listeners** are the tiles: they get every change of the value (more than 0.01°) and read `light` when they
+///   draw. They don't keep the sensor on.
+/// · it stops when the app resigns active and when Reduce Motion is on (then the tiles don't lean and the light
+///   follows only the finger).
+public final class GlassGiftMotion {
+    public static let shared = GlassGiftMotion()
+
+    private final class WeakView {
+        weak var view: UIView?
+
+        init(_ view: UIView) {
+            self.view = view
+        }
+    }
+
+    /// Held by whoever shows gift tiles (a gifts pane); the source runs while one of their views is on screen.
+    /// Dropping it unregisters.
+    public final class Client {
+        fileprivate let id: Int
+        private weak var source: GlassGiftMotion?
+
+        fileprivate init(id: Int, source: GlassGiftMotion) {
+            self.id = id
+            self.source = source
+        }
+
+        deinit {
+            let id = self.id
+            let source = self.source
+            if Thread.isMainThread {
+                source?.removeClient(id: id)
+            } else {
+                DispatchQueue.main.async {
+                    source?.removeClient(id: id)
+                }
+            }
+        }
+    }
+
+    /// A tile's subscription to the value; dropping it unsubscribes.
+    public final class Listener {
+        fileprivate let id: Int
+        private weak var source: GlassGiftMotion?
+
+        fileprivate init(id: Int, source: GlassGiftMotion) {
+            self.id = id
+            self.source = source
+        }
+
+        deinit {
+            let id = self.id
+            let source = self.source
+            if Thread.isMainThread {
+                source?.removeListener(id: id)
+            } else {
+                DispatchQueue.main.async {
+                    source?.removeListener(id: id)
+                }
+            }
+        }
+    }
+
+    private enum Phase {
+        case stopped
+        /// Clients exist but none is on screen: no sensor, a look twice a second.
+        case standby
+        case running
+    }
+
+    /// Smallest change (degrees) passed on to the tiles.
+    private static let threshold: Double = 0.01
+    /// The sensor's rate (the wallet card's, WalletCardBackgroundView.swift:37-41).
+    private static let interval: Double = 1.0 / 60.0
+    /// How often a source on standby looks for a client on screen.
+    private static let standbyInterval: Double = 0.5
+
+    /// The current tilt in screen axes, nil while the source doesn't run.
+    public private(set) var light: GlassGiftLight?
+
+    private let manager = CMMotionManager()
+    private var filter = GlassGiftMotionFilter()
+    private var integrator = GlassGiftRotationIntegrator()
+    private var phase: Phase = .stopped
+    /// Client id → its view (weak: the source never keeps a pane alive).
+    private var clients: [Int: WeakView] = [:]
+    private var listeners: [Int: (GlassGiftLight?) -> Void] = [:]
+    private var nextId = 0
+    private var standbyTimer: Timer?
+    private var observers: [NSObjectProtocol] = []
+    private var isApplicationActive = true
+
+    private init() {
+        self.manager.deviceMotionUpdateInterval = GlassGiftMotion.interval
+        if Bundle.main.bundlePath.hasSuffix(".appex") {
+            self.isApplicationActive = true
+        } else {
+            self.isApplicationActive = UIApplication.shared.applicationState == .active
+        }
+        let center = NotificationCenter.default
+        self.observers.append(center.addObserver(forName: UIApplication.willResignActiveNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.isApplicationActive = false
+            self?.updatePhase()
+        }))
+        self.observers.append(center.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.isApplicationActive = true
+            self?.updatePhase()
+        }))
+        self.observers.append(center.addObserver(forName: UIAccessibility.reduceMotionStatusDidChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.updatePhase()
+        }))
+    }
+
+    /// Registers something that shows gift tiles (its `view` is checked for being on screen). Keep the client while
+    /// the view is in the window (`didEnterHierarchy` … `didExitHierarchy`).
+    public func addClient(view: UIView) -> Client {
+        self.nextId += 1
+        self.clients[self.nextId] = WeakView(view)
+        let client = Client(id: self.nextId, source: self)
+        self.updatePhase()
+        return client
+    }
+
+    /// `update` gets every change of the value (nil when the source stops).
+    public func addListener(_ update: @escaping (GlassGiftLight?) -> Void) -> Listener {
+        self.nextId += 1
+        self.listeners[self.nextId] = update
+        return Listener(id: self.nextId, source: self)
+    }
+
+    private func removeClient(id: Int) {
+        self.clients.removeValue(forKey: id)
+        self.updatePhase()
+    }
+
+    private func removeListener(id: Int) {
+        self.listeners.removeValue(forKey: id)
+    }
+
+    /// The first client view that is on screen, if any.
+    private func visibleClientView() -> UIView? {
+        for (_, client) in self.clients {
+            if let view = client.view, GlassGiftMotion.isOnScreen(view) {
+                return view
+            }
+        }
+        return nil
+    }
+
+    /// Whether `view` shows at least a sliver in its window (a pane next to the selected one lies outside it).
+    public static func isOnScreen(_ view: UIView) -> Bool {
+        guard let window = view.window, !view.isHidden, view.alpha > 0.01 else {
+            return false
+        }
+        let frame = view.convert(view.bounds, to: window).intersection(window.bounds)
+        return !frame.isNull && frame.width >= 1.0 && frame.height >= 1.0
+    }
+
+    private var canRun: Bool {
+        return self.isApplicationActive && !UIAccessibility.isReduceMotionEnabled && self.manager.isDeviceMotionAvailable
+    }
+
+    private func updatePhase() {
+        let phase: Phase
+        if self.clients.isEmpty || !self.canRun {
+            phase = .stopped
+        } else if self.visibleClientView() != nil {
+            phase = .running
+        } else {
+            phase = .standby
+        }
+        self.setPhase(phase)
+    }
+
+    private func setPhase(_ phase: Phase) {
+        if self.phase == phase {
+            return
+        }
+        self.phase = phase
+
+        if phase == .running {
+            self.standbyTimer?.invalidate()
+            self.standbyTimer = nil
+            // The first reading is the reference again: the light starts from neutral.
+            self.filter.reset()
+            self.integrator.reset()
+            self.manager.startDeviceMotionUpdates(to: .main, withHandler: { [weak self] motion, _ in
+                guard let self, let motion else {
+                    return
+                }
+                self.handle(motion)
+            })
+        } else {
+            if self.manager.isDeviceMotionActive {
+                self.manager.stopDeviceMotionUpdates()
+            }
+            self.publish(nil)
+            if phase == .standby {
+                if self.standbyTimer == nil {
+                    let timer = Timer(timeInterval: GlassGiftMotion.standbyInterval, repeats: true, block: { [weak self] _ in
+                        self?.updatePhase()
+                    })
+                    self.standbyTimer = timer
+                    RunLoop.main.add(timer, forMode: .common)
+                }
+            } else {
+                self.standbyTimer?.invalidate()
+                self.standbyTimer = nil
+            }
+        }
+    }
+
+    private func handle(_ motion: CMDeviceMotion) {
+        guard self.phase == .running else {
+            return
+        }
+        guard let view = self.visibleClientView() else {
+            self.updatePhase()
+            return
+        }
+        let dt = self.integrator.add(rateX: motion.rotationRate.x, rateY: motion.rotationRate.y, timestamp: motion.timestamp)
+        self.filter.feed(beta: self.integrator.beta, gamma: self.integrator.gamma)
+        guard let value = self.filter.update(dt: dt) else {
+            return
+        }
+        let light = GlassGiftMotion.screenRotation(of: view).apply(value)
+        if let current = self.light, abs(current.x - light.x) < GlassGiftMotion.threshold && abs(current.y - light.y) < GlassGiftMotion.threshold {
+            return
+        }
+        self.publish(light)
+    }
+
+    private func publish(_ light: GlassGiftLight?) {
+        if self.light == light {
+            return
+        }
+        self.light = light
+        for (_, update) in self.listeners {
+            update(light)
+        }
+    }
+
+    private static func screenRotation(of view: UIView) -> GlassGiftScreenRotation {
+        switch view.window?.windowScene?.interfaceOrientation ?? .portrait {
+        case .portraitUpsideDown:
+            return .portraitUpsideDown
+        case .landscapeLeft:
+            return .landscapeLeft
+        case .landscapeRight:
+            return .landscapeRight
+        default:
+            return .portrait
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftMotionFilter.swift b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftMotionFilter.swift
new file mode 100644
index 0000000..0e38936
--- /dev/null
+++ b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftMotionFilter.swift
@@ -0,0 +1,141 @@
+import Foundation
+
+// The phone's tilt as the gift light reads it — the Swift twin of `MotionSource` in prototype/src/profile/glass-gifts.js
+// (pinned to the same golden frames as GlassTileModel). As the TON wallet card reads its device motion
+// (WalletCardBackgroundView.swift:84-118): the first reading is the reference, the value is smoothed over 0.1 s
+// (WCB:118), and the reference slowly follows the phone (~4 s) so that a held pose turns neutral. Degrees; ±20 → full
+// effect. Pure Swift (Foundation only); GlassGiftMotion feeds it from Core Motion.
+
+/// `MotionSource.feed` / `update` / `set`.
+public struct GlassGiftMotionFilter {
+    /// Degrees of tilt that give the full effect.
+    public static let range: Double = 20.0
+    /// Seconds: the value follows the tilt with 1 − e^(−dt / 0.1) (WCB:118).
+    public static let smoothing: Double = 0.1
+    /// Seconds: the reference follows the phone with 1 − e^(−dt / 4).
+    public static let recentring: Double = 4.0
+
+    private struct Angles {
+        var beta: Double
+        var gamma: Double
+    }
+
+    public private(set) var value = GlassGiftLight(x: 0.0, y: 0.0)
+    private var base: Angles?
+    private var current: Angles?
+
+    /// Scripted tilt (demo videos): returned as is instead of the sensors' value; nil goes back to the sensors.
+    public var override: GlassGiftLight?
+
+    public init() {
+    }
+
+    /// True once a reading arrived (`update` returns a value).
+    public var hasReading: Bool {
+        return self.current != nil && self.base != nil
+    }
+
+    /// A reading, as DeviceOrientationEvent gives it: `beta` front-back (degrees, positive when the top edge comes up
+    /// toward the viewer), `gamma` left-right (positive when the right edge goes down / away). The first one is the
+    /// reference.
+    public mutating func feed(beta: Double, gamma: Double) {
+        let reading = Angles(beta: beta, gamma: gamma)
+        self.current = reading
+        if self.base == nil {
+            self.base = reading
+        }
+    }
+
+    /// One step of `dt` seconds. Nil until the first reading (and without an override).
+    public mutating func update(dt: Double) -> GlassGiftLight? {
+        if let override = self.override {
+            return override
+        }
+        guard let current = self.current, var base = self.base else {
+            return nil
+        }
+        // Re-centre over ~4 s.
+        let d = 1.0 - exp(-dt / GlassGiftMotionFilter.recentring)
+        base.beta += (current.beta - base.beta) * d
+        base.gamma += (current.gamma - base.gamma) * d
+        self.base = base
+        let k = 1.0 - exp(-dt / GlassGiftMotionFilter.smoothing)
+        let range = GlassGiftMotionFilter.range
+        self.value.x += (max(-range, min(range, current.gamma - base.gamma)) - self.value.x) * k
+        self.value.y += (max(-range, min(range, current.beta - base.beta)) - self.value.y) * k
+        return self.value
+    }
+
+    /// Forgets the readings: the next one is the reference again, and the value starts from neutral.
+    public mutating func reset() {
+        self.value = GlassGiftLight(x: 0.0, y: 0.0)
+        self.base = nil
+        self.current = nil
+    }
+}
+
+/// Turns the gyroscope's rotation rate into the readings `GlassGiftMotionFilter` takes.
+///
+/// The browser's beta / gamma (DeviceOrientationEvent) are Euler angles of the gravity direction: they lock up when the
+/// phone is held upright (beta ≈ 90°), the way most people hold it while standing. Here the readings are the phone's
+/// rotation about its own x axis (beta) and y axis (gamma) since the first reading, integrated from the gyroscope's
+/// bias-corrected rate (CMDeviceMotion.rotationRate, device axes, right-hand rule): the same directions as the
+/// browser's angles for small tilts, at any holding angle. The filter only ever uses the difference to its slowly
+/// re-centring reference, so a slow drift of the sum never shows.
+public struct GlassGiftRotationIntegrator {
+    /// Gaps longer than this (a paused sensor, a stalled main thread) count as this long.
+    public static let maxStep: Double = 0.1
+
+    public private(set) var beta: Double = 0.0
+    public private(set) var gamma: Double = 0.0
+    private var lastTimestamp: Double?
+
+    public init() {
+    }
+
+    /// One sample: `rate` in radians per second about the device's x and y axes, `timestamp` in seconds. Returns the
+    /// time since the previous sample (0 for the first one).
+    public mutating func add(rateX: Double, rateY: Double, timestamp: Double) -> Double {
+        let dt: Double
+        if let lastTimestamp = self.lastTimestamp {
+            dt = max(0.0, min(GlassGiftRotationIntegrator.maxStep, timestamp - lastTimestamp))
+        } else {
+            dt = 0.0
+        }
+        self.lastTimestamp = timestamp
+        self.beta += rateX * dt * 180.0 / Double.pi
+        self.gamma += rateY * dt * 180.0 / Double.pi
+        return dt
+    }
+
+    public mutating func reset() {
+        self.beta = 0.0
+        self.gamma = 0.0
+        self.lastTimestamp = nil
+    }
+}
+
+/// The device axes in the screen's: the light moves with the interface, not with the hardware (iPad, landscape).
+public enum GlassGiftScreenRotation {
+    case portrait
+    case portraitUpsideDown
+    /// Home button / bottom edge on the left: the device's top edge points to the screen's right.
+    case landscapeLeft
+    /// Home button / bottom edge on the right: the device's top edge points to the screen's left.
+    case landscapeRight
+
+    /// `light` in device axes (x along the device's right edge, y toward its bottom edge) → screen axes (x right,
+    /// y down).
+    public func apply(_ light: GlassGiftLight) -> GlassGiftLight {
+        switch self {
+        case .portrait:
+            return light
+        case .portraitUpsideDown:
+            return GlassGiftLight(x: -light.x, y: -light.y)
+        case .landscapeLeft:
+            return GlassGiftLight(x: -light.y, y: light.x)
+        case .landscapeRight:
+            return GlassGiftLight(x: light.y, y: -light.x)
+        }
+    }
+}
diff --git a/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftTile.swift b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftTile.swift
new file mode 100644
index 0000000..9445271
--- /dev/null
+++ b/submodules/TelegramUI/Components/Gifts/GlassGifts/Sources/GlassGiftTile.swift
@@ -0,0 +1,473 @@
+import Foundation
+import UIKit
+import Display
+
+/// The glass on one gift tile: `GiftItemComponent.View` on a profile's Gifts tab (prototype/src/profile/profile-page.js,
+/// the tile part of the grid; the look is prototype/styles/telegram.css `.gift-*`).
+///
+/// The tile view keeps all its own layers and layout; the glass adds its layers next to them (GlassGiftTileLayers) and
+/// leans the whole tile through the view's `sublayerTransform`, which never touches the frame the grid sets. The parts
+/// that float above the glass — the sticker (and what sits on it: the hidden-gift badge, the resale price), the corner
+/// ribbon, the sender's avatar and the other corner badges — get their depth as `zPosition`, so the tile's perspective
+/// gives them parallax; the sticker also slides a little over the glass.
+///
+/// Telegram's context gesture (ContextControllerSourceView, 0.12 s, then a shrink to (w − 15) / w over 0.2 s and the
+/// menu) shrinks the tile through the same `sublayerTransform`, so the glass takes it over: its progress
+/// (`customActivationProgress`) becomes one factor of the tile's transform, eased back exactly as the default does
+/// (0.2 s ease-out).
+///
+/// Lifecycle — nothing animates at rest:
+/// · a touch, a release, a burst, the press shrink and the depth fading in or out run a display link
+///   (`SharedDisplayLinkDriver`, `.max`) that stops when everything has settled;
+/// · the phone's tilt (GlassGiftMotion, only while a gifts pane is on screen) is drawn as it arrives;
+/// · at rest with no light the tile's transform is exactly identity and nothing floats: the tile keeps its own
+///   geometry under the glass's static light. The depth (`zPosition` and the perspective) fades in over ~0.2 s when the
+///   glass wakes (the sticker lifts toward you a little more than the ×1.01 of the glass) and out when it rests again.
+/// Reduce Motion: no lean, lift, depth or sticker slide; the light still follows the finger (sheen, streak, edge,
+/// fragments, sparkles) and not the phone (GlassGiftMotion doesn't run).
+public final class GlassGiftTile {
+    /// A layer that floats above the glass.
+    private final class FloatingPart {
+        weak var layer: CALayer?
+        let depth: Double
+        let slides: Bool
+        /// Where the tile view put it (the glass adds the slide on top).
+        var basePosition: CGPoint
+        /// What the glass last wrote, to tell the tile view's own layout from the glass's slide.
+        var writtenPosition: CGPoint?
+
+        init(layer: CALayer, depth: Double, slides: Bool) {
+            self.layer = layer
+            self.depth = depth
+            self.slides = slides
+            self.basePosition = layer.position
+        }
+
+        func restore() {
+            guard let layer = self.layer else {
+                return
+            }
+            layer.zPosition = 0.0
+            if self.slides, let writtenPosition = self.writtenPosition, layer.position == writtenPosition {
+                layer.position = self.basePosition
+            }
+            self.writtenPosition = nil
+        }
+    }
+
+    /// The press shrink of Telegram's context gesture (ContextControllerSourceNode.swift:237-291).
+    private struct Press {
+        var scale: CGFloat = 1.0
+        var easing: (from: CGFloat, start: Double)?
+    }
+
+    /// The context gesture's ease back: 0.2 s, ease-out (ContextControllerSourceNode.swift:278).
+    private static let pressReleaseDuration: Double = 0.2
+    /// The light counts as "on" (the depth stays up) above this tilt, degrees.
+    private static let lightThreshold: Double = 0.05
+
+    private weak var hostView: ContextControllerSourceView?
+    private var model = GlassTileModel()
+    private let layers = GlassGiftTileLayers()
+    private let gestureRecognizer: GlassGiftGestureRecognizer
+    private var displayLink: SharedDisplayLinkDriver.Link?
+    private var lastFrameTime: Double?
+    private var motionListener: GlassGiftMotion.Listener?
+    private var light: GlassGiftLight?
+    private var press = Press()
+    /// 0 at rest … 1 awake: scales the perspective and the parts' depth.
+    private var depthFactor: Double = 0.0
+    private var floatingParts: [FloatingPart] = []
+    private var reduceMotionObserver: NSObjectProtocol?
+    private var isRemoved = false
+
+    /// `hostView` is the tile (GiftItemComponent.View). The glass installs its gesture recognizer and takes over the
+    /// press shrink of its context gesture until `remove()`.
+    public init(hostView: ContextControllerSourceView) {
+        self.hostView = hostView
+        self.gestureRecognizer = GlassGiftGestureRecognizer(target: nil, action: nil)
+        self.gestureRecognizer.tile = self
+        hostView.addGestureRecognizer(self.gestureRecognizer)
+
+        hostView.customActivationProgress = { [weak self] progress, transition in
+            self?.updatePress(progress: progress, transition: transition)
+        }
+
+        self.layers.shadow.didEnterHierarchy = { [weak self] in
+            self?.updateIsInHierarchy()
+        }
+        self.layers.shadow.didExitHierarchy = { [weak self] in
+            self?.updateIsInHierarchy()
+        }
+        self.reduceMotionObserver = NotificationCenter.default.addObserver(forName: UIAccessibility.reduceMotionStatusDidChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.redraw()
+        })
+    }
+
+    deinit {
+        self.displayLink?.invalidate()
+        if let reduceMotionObserver = self.reduceMotionObserver {
+            NotificationCenter.default.removeObserver(reduceMotionObserver)
+        }
+    }
+
+    /// Lays the glass out over the tile; the tile view calls it at the end of every update.
+    /// - backdrop: the topmost layer of the tile's backdrop (the collectible pattern view's, else its background
+    ///   layer): the glass light goes right above it.
+    /// - gift: the sticker; giftOverlays: what sits on it (the hidden-gift badge, the resale price). They float
+    ///   `GlassGiftLook.giftDepth` above the glass and slide with the lean.
+    /// - ribbon: the corner ribbon (`ribbonDepth`); badges: the sender's avatar and the corner badges (`badgeDepth`).
+    /// Views that are nil or not (any more) in the tile view are skipped.
+    public func update(
+        size: CGSize,
+        cornerRadius: CGFloat,
+        isDark: Bool,
+        isCollectible: Bool,
+        backdrop: CALayer,
+        gift: CALayer?,
+        giftOverlays: [UIView?],
+        ribbon: [UIView?],
+        badges: [UIView?]
+    ) {
+        guard let hostView = self.hostView, !self.isRemoved else {
+            return
+        }
+        let floatingLayers: ([UIView?]) -> [CALayer] = { views in
+            return views.compactMap { view -> CALayer? in
+                guard let view, view.superview === hostView else {
+                    return nil
+                }
+                return view.layer
+            }
+        }
+        var giftLayers = floatingLayers(giftOverlays)
+        if let gift, gift.superlayer === hostView.layer {
+            giftLayers.insert(gift, at: 0)
+        }
+        self.layers.update(size: size, cornerRadius: cornerRadius, isDark: isDark, isCollectible: isCollectible)
+
+        let hostLayer = hostView.layer
+        if self.layers.shadow.superlayer !== hostLayer || hostLayer.sublayers?.first !== self.layers.shadow {
+            hostLayer.insertSublayer(self.layers.shadow, at: 0)
+        }
+        // The glass light right above the backdrop, in order.
+        var anchor = backdrop.superlayer === hostLayer ? backdrop : self.layers.shadow
+        for layer in self.layers.glassLayers {
+            if layer.superlayer !== hostLayer || !GlassGiftTile.isDirectlyAbove(layer, anchor, in: hostLayer) {
+                hostLayer.insertSublayer(layer, above: anchor)
+            }
+            anchor = layer
+        }
+        for sparkle in self.layers.sparkles where sparkle.superlayer !== hostLayer {
+            hostLayer.addSublayer(sparkle)
+        }
+
+        self.updateFloatingParts(gift: giftLayers, ribbon: floatingLayers(ribbon), badges: floatingLayers(badges))
+        self.updateIsInHierarchy()
+        self.redraw()
+    }
+
+    /// Takes the glass off the tile: its layers, the depth, the transform, the gesture and the press shrink.
+    public func remove() {
+        if self.isRemoved {
+            return
+        }
+        self.isRemoved = true
+        self.stopDisplayLink()
+        self.motionListener = nil
+        for part in self.floatingParts {
+            part.restore()
+        }
+        self.floatingParts.removeAll()
+        for layer in [self.layers.shadow] + self.layers.glassLayers + self.layers.sparkles {
+            layer.removeFromSuperlayer()
+        }
+        if let hostView = self.hostView {
+            hostView.removeGestureRecognizer(self.gestureRecognizer)
+            hostView.customActivationProgress = nil
+            hostView.layer.sublayerTransform = CATransform3DIdentity
+        }
+        self.gestureRecognizer.tile = nil
+    }
+
+    // MARK: - Interaction (GlassGiftGestureRecognizer)
+
+    /// Touch down at `point` (tile coordinates): the glass leans toward it and a burst of light runs across it.
+    func touchDown(at point: CGPoint) {
+        // A touched tile is in the window, whatever its layers were told.
+        self.updateIsInHierarchy()
+        self.aim(at: point)
+        self.burst()
+    }
+
+    /// The finger at `point` (tile coordinates; outside the tile counts as its edge).
+    func aim(at point: CGPoint) {
+        let size = self.layers.size
+        guard size.width > 0.0, size.height > 0.0 else {
+            return
+        }
+        self.model.aim(u: Double(point.x / size.width) * 2.0 - 1.0, v: Double(point.y / size.height) * 2.0 - 1.0)
+        self.startDisplayLink()
+    }
+
+    func burst() {
+        self.model.burst(at: CACurrentMediaTime())
+        self.startDisplayLink()
+    }
+
+    /// The finger left: the glass eases home.
+    func release() {
+        self.model.release()
+        self.startDisplayLink()
+    }
+
+    // MARK: - Drawing
+
+    private func updateFloatingParts(gift: [CALayer], ribbon: [CALayer], badges: [CALayer]) {
+        let groups: [(layers: [CALayer], depth: Double, slides: Bool)] = [
+            (gift, GlassGiftLook.giftDepth, true),
+            (ribbon, GlassGiftLook.ribbonDepth, false),
+            (badges, GlassGiftLook.badgeDepth, false)
+        ]
+        var parts: [FloatingPart] = []
+        for group in groups {
+            for layer in group.layers {
+                if let part = self.floatingParts.first(where: { $0.layer === layer && $0.depth == group.depth }) {
+                    // The tile view laid it out again since the glass last moved it: that is the new base.
+                    if part.writtenPosition == nil || layer.position != part.writtenPosition {
+                        part.basePosition = layer.position
+                        part.writtenPosition = nil
+                    }
+                    parts.append(part)
+                } else {
+                    parts.append(FloatingPart(layer: layer, depth: group.depth, slides: group.slides))
+                }
+            }
+        }
+        for part in self.floatingParts where !parts.contains(where: { $0 === part }) {
+            part.restore()
+        }
+        self.floatingParts = parts
+    }
+
+    /// The tile is in a window: the glass's own layer says so (kCAOnOrderIn, as the sticker layer knows it), or the
+    /// view does.
+    private var isInHierarchy: Bool {
+        return !self.isRemoved && (self.layers.shadow.isInHierarchy || self.hostView?.window != nil)
+    }
+
+    private func updateIsInHierarchy() {
+        if self.isInHierarchy {
+            if self.motionListener == nil {
+                self.light = GlassGiftMotion.shared.light
+                self.motionListener = GlassGiftMotion.shared.addListener({ [weak self] light in
+                    self?.lightUpdated(light)
+                })
+            }
+        } else if self.motionListener != nil || self.displayLink != nil {
+            // Off the window: no light, no animation; back at rest when it returns.
+            self.motionListener = nil
+            self.light = nil
+            self.settle()
+        }
+    }
+
+    private func lightUpdated(_ light: GlassGiftLight?) {
+        self.light = light
+        if self.displayLink == nil {
+            self.redraw()
+        }
+    }
+
+    private func updatePress(progress: CGFloat, transition: ContextGestureTransition) {
+        let width = self.layers.size.width
+        guard width > 0.0 else {
+            return
+        }
+        // ContextControllerSourceView's own shrink: max(0.7, (w − 15) / w) at full progress.
+        let minScale = max(0.7, (width - 15.0) / width)
+        let scale = 1.0 * (1.0 - progress) + minScale * progress
+        switch transition {
+        case .begin, .update:
+            self.press.scale = scale
+            self.press.easing = nil
+            if self.displayLink == nil {
+                self.redraw()
+            }
+        case .ended:
+            self.press.easing = (self.press.scale, CACurrentMediaTime())
+            self.startDisplayLink()
+        }
+    }
+
+    private func startDisplayLink() {
+        if !self.isInHierarchy {
+            return
+        }
+        if self.displayLink == nil {
+            self.lastFrameTime = CACurrentMediaTime()
+            self.displayLink = SharedDisplayLinkDriver.shared.add(framesPerSecond: .max, { [weak self] _ in
+                self?.tick()
+            })
+        }
+    }
+
+    private func stopDisplayLink() {
+        self.displayLink?.invalidate()
+        self.displayLink = nil
+        self.lastFrameTime = nil
+    }
+
+    private func tick() {
+        let now = CACurrentMediaTime()
+        // The page's frame step: 0…50 ms (profile-page.js `update`).
+        let dt = max(0.0, min(0.05, now - (self.lastFrameTime ?? now)))
+        self.lastFrameTime = now
+
+        let state = self.model.update(now: now, dt: dt, light: self.light)
+        let pressSettled = self.advancePress(now: now)
+        let depthSettled = self.advanceDepth(state: state, dt: dt)
+        self.draw(state)
+        if !state.isActive && pressSettled && depthSettled {
+            self.stopDisplayLink()
+        }
+    }
+
+    /// A frame without advancing time (the light moved, or the tile view laid out).
+    private func redraw() {
+        if self.isRemoved {
+            return
+        }
+        let state = self.model.update(now: CACurrentMediaTime(), dt: 0.0, light: self.light)
+        if self.depthTarget(state) != self.depthFactor {
+            self.startDisplayLink()
+        }
+        self.draw(state)
+    }
+
+    /// Back at rest at once: no lean, no depth, no press.
+    private func settle() {
+        self.stopDisplayLink()
+        self.model = GlassTileModel()
+        self.press = Press()
+        self.depthFactor = 0.0
+        self.draw(self.model.update(now: CACurrentMediaTime(), dt: 0.0, light: self.light))
+    }
+
+    private func advancePress(now: Double) -> Bool {
+        guard let easing = self.press.easing else {
+            return true
+        }
+        let t = (now - easing.start) / GlassGiftTile.pressReleaseDuration
+        if t >= 1.0 {
+            self.press.scale = 1.0
+            self.press.easing = nil
+            return true
+        }
+        self.press.scale = easing.from + (1.0 - easing.from) * CGFloat(GlassGiftTiming.easeOut(t))
+        return false
+    }
+
+    private func depthTarget(_ state: GlassTileState) -> Double {
+        if UIAccessibility.isReduceMotionEnabled {
+            return 0.0
+        }
+        if state.isActive || self.model.isTouching {
+            return 1.0
+        }
+        if let light = self.light, max(abs(light.x), abs(light.y)) > GlassGiftTile.lightThreshold {
+            return 1.0
+        }
+        return 0.0
+    }
+
+    /// The depth follows its target like the wallet card's scale: 1 − e^(−12 dt) (WCC:918).
+    private func advanceDepth(state: GlassTileState, dt: Double) -> Bool {
+        let target = self.depthTarget(state)
+        self.depthFactor += (target - self.depthFactor) * (1.0 - exp(-12.0 * dt))
+        if abs(target - self.depthFactor) < 0.001 {
+            self.depthFactor = target
+            return true
+        }
+        return false
+    }
+
+    private func draw(_ state: GlassTileState) {
+        guard let hostView = self.hostView, !self.isRemoved else {
+            return
+        }
+        let reduceMotion = UIAccessibility.isReduceMotionEnabled
+        let k = self.depthFactor
+
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+
+        self.layers.apply(state)
+        self.layers.setResting(k == 0.0 && !state.isActive && !self.model.isTouching && self.press.scale == 1.0 && self.press.easing == nil)
+
+        // The tile leans as one: perspective, translate, scale, rotate X / Y / Z (the wallet card's order), then the
+        // press shrink about the centre. At rest (k = 0 and no lean) this is exactly identity.
+        let tilt: CATransform3D
+        if reduceMotion || (k == 0.0 && !state.isActive) {
+            // No lean (Reduce Motion), or resting with at most a hint of light (below `lightThreshold`): flat.
+            tilt = CATransform3DIdentity
+        } else {
+            tilt = GlassGiftTile.tiltTransform(state, perspectiveFactor: k)
+        }
+        hostView.layer.sublayerTransform = CATransform3DConcat(tilt, CATransform3DMakeScale(self.press.scale, self.press.scale, 1.0))
